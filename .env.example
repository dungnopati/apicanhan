# ===================================================================
# GEMINIBRIDGE - CẤU HÌNH HỆ THỐNG DÙNG CHUNG CHO CÁC TOOL AI
# ===================================================================
# Hỗ trợ 3 phương thức kết nối:
# 1. Browser:  Mở trực tiếp trình duyệt Microsoft Edge / Chrome cá nhân (Tạo ảnh Imagen 3 xịn nhất)
# 2. Official: Sử dụng Google Gemini API Key chính thức (Khuyên dùng cho text)
# 3. WebAPI:   Sử dụng Cookie tài khoản Gemini web cá nhân (__Secure-1PSID)
# ===================================================================

# [PHƯƠNG THỨC 1] Trình duyệt cá nhân (Browser)
BROWSER_CHANNEL=msedge
BROWSER_HEADLESS=false
BROWSER_PROFILE_DIR=browser_profile

# [PHƯƠNG THỨC 2] Google Gemini API Key chính thức
# Lấy miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# [PHƯƠNG THỨC 3] Cookie tài khoản cá nhân Gemini Web (Dành cho WebAPI)
# Lấy từ F12 -> Application -> Cookies tại trang gemini.google.com
GEMINI_SECURE_1PSID=YOUR_SECURE_1PSID_COOKIE_HERE
GEMINI_SECURE_1PSIDTS=

# [BẮT BUỘC CHỌN 1 TRONG 3] Kiểu kết nối đang dùng:
# - browser:  Mở trực tiếp trình duyệt cá nhân (Khuyên dùng cho Imagen 3 tạo ảnh đẹp)
# - official: Sử dụng API Key chính thức
# - webapi:   Sử dụng Cookie tài khoản cá nhân đã điền ở trên
GEMINI_BACKEND_TYPE=browser

# [TÙY CHỌN] Mô hình mặc định sử dụng
DEFAULT_MODEL=gemini-2.0-flash

# [TÙY CHỌN] Cấu hình máy chủ nội bộ
HOST=127.0.0.1
PORT=8200

# ===================================================================
# CẤU HÌNH CỔNG NẠP TIỀN TỰ ĐỘNG & VIETQR (TINGO PAY) 24/7
# ===================================================================
VIETQR_MERCHANT_NAME=APICANHAN
VIETQR_USERNAME=admin
VIETQR_PASSWORD=Apicanhan@2026

# Thông tin tài khoản ngân hàng nhận tiền nạp
# Mã ngân hàng (ví dụ: MB, TCB, VCB, ACB, TPB, VPB, BIDV, CTG...)
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=0000000000
VIETQR_ACCOUNT_NAME=CHU TAI KHOAN
PAYMENT_PREFIX=NAP
