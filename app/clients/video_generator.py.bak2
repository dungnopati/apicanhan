import re
import asyncio
import base64
import logging
import uuid
from pathlib import Path
from typing import Optional

from app.config import settings

logger = logging.getLogger(__name__)

BASE_DIR = Path(__file__).resolve().parent.parent.parent
VIDEOS_DIR = BASE_DIR / "outputs" / "generated_videos"
VIDEOS_DIR.mkdir(parents=True, exist_ok=True)


from app.clients.locks import browser_lock


class VideoAutomationManager:
    """Quản lý tự động hóa tạo video AI trên Google Vids và Google Flow qua trình duyệt Edge/Chrome trực quan."""

    def __init__(self):
        self._lock = browser_lock
        self._profile_dir = BASE_DIR / settings.BROWSER_PROFILE_DIR
        self._profile_dir.mkdir(parents=True, exist_ok=True)
        self._playwright = None
        self._context = None

    def _cleanup_orphaned_locks(self):
        """Xóa lockfile nếu phiên trước bị dừng đột ngột."""
        lock = self._profile_dir / "lockfile"
        if lock.exists():
            try:
                lock.unlink()
            except Exception:
                pass

    async def _ensure_browser_context(self):
        """Khởi động hoặc tái sử dụng context trình duyệt Edge/Chrome trực quan trên màn hình."""
        if self._context is not None:
            try:
                if self._context.pages:
                    return self._context
            except Exception:
                self._context = None

        from playwright.async_api import async_playwright

        if self._playwright is None:
            self._playwright = await async_playwright().start()

        # 1. Kết nối vào cửa sổ trình duyệt Edge đang mở sẵn qua remote debugging port 9222
        try:
            cdp_browser = await self._playwright.chromium.connect_over_cdp("http://127.0.0.1:9222", timeout=2000)
            if cdp_browser.contexts:
                self._context = cdp_browser.contexts[0]
                logger.info("[VideoManager] Đã kết nối vào cửa sổ Edge đang mở sẵn trên màn hình (CDP:9222)!")
                return self._context
        except Exception:
            pass

        # 2. Nếu chưa mở, thử khởi động Edge qua Windows shell để đảm bảo hiển thị cửa sổ thật trên màn hình
        import sys, subprocess
        if sys.platform == "win32":
            try:
                self._cleanup_orphaned_locks()
                edge_exe = 'msedge.exe'
                for ep in [r'C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe', r'C:\Program Files\Microsoft\Edge\Application\msedge.exe']:
                    if Path(ep).exists():
                        edge_exe = f'"{ep}"'
                        break
                cmd = f'start "" {edge_exe} --remote-debugging-port=9222 --user-data-dir="{self._profile_dir}" --start-maximized "https://vids.new" "https://flow.google.com" "https://gemini.google.com/app"'
                subprocess.Popen(cmd, shell=True)
                for _ in range(16):
                    await asyncio.sleep(0.5)
                    try:
                        cdp_browser = await self._playwright.chromium.connect_over_cdp("http://127.0.0.1:9222", timeout=1500)
                        if cdp_browser.contexts:
                            self._context = cdp_browser.contexts[0]
                            logger.info("[VideoManager] Đã kết nối vào cửa sổ Edge vừa mở trên màn hình!")
                            return self._context
                    except Exception:
                        pass
            except Exception as exc:
                logger.warning(f"[VideoManager] Mở Edge qua Windows shell không thành công: {exc}")

        # 3. Dự phòng mở qua Playwright launch_persistent_context (headless=False)
        self._cleanup_orphaned_locks()
        args = [
            "--remote-debugging-port=9222",
            "--disable-blink-features=AutomationControlled",
            "--no-sandbox",
            "--disable-infobars",
            "--start-maximized",
            "--disable-background-mode",
        ]

        channel = settings.BROWSER_CHANNEL
        channels_to_try = [channel]
        if channel == "msedge" and "chrome" not in channels_to_try:
            channels_to_try.append("chrome")
        elif channel == "chrome" and "msedge" not in channels_to_try:
            channels_to_try.append("msedge")
        channels_to_try.append(None)

        for ch in channels_to_try:
            try:
                self._cleanup_orphaned_locks()
                launch_kwargs = {
                    "user_data_dir": str(self._profile_dir),
                    "headless": False,  # Luôn giữ cửa sổ thật trên màn hình để người dùng thấy và đăng nhập
                    "no_viewport": True,
                    "args": args,
                    "timeout": 45000,
                }
                if ch:
                    launch_kwargs["channel"] = ch
                self._context = await self._playwright.chromium.launch_persistent_context(**launch_kwargs)
                logger.info(f"[VideoManager] Đã mở cửa sổ trình duyệt {str(ch).upper()} trên màn hình!")
                return self._context
            except Exception as exc:
                logger.warning(f"[VideoManager] Kênh {ch} không khởi động được: {exc}")
                await asyncio.sleep(0.5)

        raise RuntimeError("Không thể mở cửa sổ trình duyệt Edge/Chrome. Vui lòng kiểm tra lại trình duyệt của bạn.")

    async def _wait_for_user_login(self, page, service_name: str, max_wait_login_secs: int = 180):
        """Kiểm tra và chờ người dùng đăng nhập tài khoản Google nếu cần thiết."""
        await page.bring_to_front()
        start_t = asyncio.get_event_loop().time()
        notified = False

        while (asyncio.get_event_loop().time() - start_t) < max_wait_login_secs:
            url = page.url
            # Kiểm tra nếu đang ở màn hình đăng nhập Google
            is_login_page = "accounts.google.com" in url
            
            # Kiểm tra nút đăng nhập trên giao diện
            has_signin_btn = await page.evaluate('''() => {
                const btns = Array.from(document.querySelectorAll('button, a'));
                return btns.some(b => {
                    const txt = (b.innerText || '').toLowerCase();
                    const aria = (b.getAttribute('aria-label') || '').toLowerCase();
                    return txt.includes('đăng nhập') || txt.includes('sign in') || aria.includes('sign in');
                });
            }''')

            if is_login_page or has_signin_btn:
                if not notified:
                    logger.info(
                        f"[{service_name}] Cửa sổ trình duyệt đã được đưa lên màn hình. "
                        f"Vui lòng nhấp vào cửa sổ trình duyệt để đăng nhập tài khoản Google của bạn. "
                        f"Hệ thống đang chờ và sẽ tự động tiếp tục ngay khi bạn đăng nhập xong..."
                    )
                    notified = True
                await page.wait_for_timeout(3000)
                continue

            # Nếu đã vào trang chính của ứng dụng
            if "accounts.google.com" not in url:
                if notified:
                    logger.info(f"[{service_name}] Phát hiện đăng nhập tài khoản Google thành công! Tiếp tục xử lý...")
                    await page.wait_for_timeout(3000)
                return True

            await page.wait_for_timeout(2000)

        raise RuntimeError(
            f"Đã hết thời gian chờ đăng nhập tài khoản Google trên {service_name}. "
            f"Vui lòng hoàn tất đăng nhập trên cửa sổ trình duyệt đang mở trên màn hình rồi thử lại."
        )

    async def generate_video_flow(
        self,
        prompt: str,
        aspect_ratio: str = "16:9",
        duration: int = 10,
        max_wait_seconds: int = 300,
    ) -> str:
        """Tạo video tự động trên Google Flow (flow.google.com) với cửa sổ trực quan mở trên màn hình."""
        # Thích ứng thời lượng: Google Flow Veo chỉ hỗ trợ 4s, 6s, 8s, 10s
        # Luôn chọn mốc GẦN NHẤT với thời lượng phân cảnh (Ví dụ: cảnh 12s -> tạo 10s; 7.5s -> tạo 8s; 5.3s -> tạo 6s)
        clean_dur = float(duration or 5.0)
        supported_dur = 10 if clean_dur >= 10.0 else min([4, 6, 8, 10], key=lambda x: abs(x - clean_dur))
        prompt = re.sub(r'\b\d+-second clip\b', f'{supported_dur}-second clip', prompt, flags=re.IGNORECASE)
        prompt = re.sub(r'\bcontinuous motion over \d+ seconds\b', f'continuous motion over {supported_dur} seconds', prompt, flags=re.IGNORECASE)
        async with self._lock:
            context = await self._ensure_browser_context()

            # Tìm tab flow.google.com đã mở sẵn hoặc mở tab mới
            page = None
            for p in context.pages:
                if "flow.google.com" in p.url:
                    page = p
                    break

            if not page:
                page = await context.new_page()
                logger.info("[Google Flow] Đang mở trang https://flow.google.com...")
                await page.goto("https://flow.google.com", wait_until="domcontentloaded", timeout=45000)

            await page.bring_to_front()
            await page.wait_for_timeout(2000)

            # 1. Kiểm tra trạng thái đăng nhập tài khoản Google
            await self._wait_for_user_login(page, "Google Flow")

            # 2. Nhấp nút "+ Dự án mới" nếu đang ở trang chủ
            if "/project/" not in page.url:
                logger.info("[Google Flow] Đang tạo dự án mới...")
                fab = await page.wait_for_selector(
                    'button.mat-mdc-fab, button:has-text("Dự án mới"), [aria-label*="Dự án mới"]',
                    timeout=15000
                )
                if fab:
                    await fab.click()
                    await page.wait_for_timeout(3000)

            # 3. Đóng các popup giới thiệu nếu có ("Bắt đầu", "Tôi hiểu")
            for sel in ['button:has-text("Bắt đầu")', 'button:has-text("Tôi hiểu")', 'button[aria-label*="Đóng"]']:
                try:
                    popup_btn = await page.query_selector(sel)
                    if popup_btn:
                        await popup_btn.click()
                        await page.wait_for_timeout(400)
                except Exception:
                    pass

            # 4. Tìm ô soạn thảo prompt câu lệnh sáng tạo
            editor = await page.wait_for_selector(
                '.ProseMirror, [aria-label*="Bạn muốn tạo gì"], [contenteditable="true"]',
                timeout=15000
            )
            if not editor:
                raise RuntimeError("Không tìm thấy ô nhập câu lệnh sáng tạo trên Google Flow.")

            await editor.click()
            await page.keyboard.press("Control+A")
            await page.keyboard.press("Backspace")
            await page.wait_for_timeout(300)
            await page.keyboard.type(prompt.strip(), delay=12)
            await page.wait_for_timeout(800)

            # 5. Bấm nút Bắt đầu tạo (arrow_forward)
            send_btn = await page.wait_for_selector(
                'button[aria-label*="Bắt đầu tạo"], button:has-text("arrow_forward"), .flow-generate-icon-button',
                timeout=6000
            )
            if send_btn and await send_btn.is_enabled():
                await send_btn.click()
            else:
                await page.keyboard.press("Enter")

            # Ghi nhận các media đã có trước để không nhặt nhầm ảnh/video cũ của phiên trước
            existing_imgs = set(await page.evaluate('''() => {
                return Array.from(document.querySelectorAll('flow-image-tile img, flow-tile-container img, .image')).map(i => i.src || '').filter(Boolean);
            }'''))
            existing_vids = set(await page.evaluate('''() => {
                return Array.from(document.querySelectorAll('video')).map(v => v.src || v.currentSrc || '').filter(Boolean);
            }'''))

            # Ghi nhận các media đã có trước để không nhặt nhầm ảnh/video cũ của phiên trước
            existing_imgs = set(await page.evaluate('''() => {
                return Array.from(document.querySelectorAll('flow-image-tile img, flow-tile-container img, .image')).map(i => i.src || '').filter(Boolean);
            }'''))
            existing_vids = set(await page.evaluate('''() => {
                return Array.from(document.querySelectorAll('video')).map(v => v.src || v.currentSrc || '').filter(Boolean);
            }'''))

            logger.info(f"[Google Flow] Đã gửi yêu cầu tạo video: '{prompt[:60]}...'. Đang theo dõi tiến trình...")
            await page.wait_for_timeout(4000)

            # 6. Chờ AI tư duy và hiển thị phân cảnh hoàn chỉnh
            start_t = asyncio.get_event_loop().time()
            video_data = None

            while (asyncio.get_event_loop().time() - start_t) < max_wait_seconds:
                # Tự động phê duyệt tín dụng nếu xuất hiện thông báo
                try:
                    await page.evaluate('''() => {
                        const labels = Array.from(document.querySelectorAll('.option-label:not(.dimmed)'));
                        for (const el of labels) {
                            const text = el.innerText.trim();
                            if (text === 'Luôn phê duyệt' || text === 'Phê duyệt') {
                                (el.closest('button') || el.closest('[role="button"]') || el.parentElement || el).click();
                                break;
                            }
                        }
                    }''')
                except Exception:
                    pass
                # Kiểm tra trạng thái bằng JavaScript chuẩn không dùng psuedo-selectors
                status = await page.evaluate('''() => {
                    const buttons = Array.from(document.querySelectorAll('button'));
                    const isThinking = buttons.some(b => {
                        const txt = b.innerText || '';
                        const aria = b.getAttribute('aria-label') || '';
                        return txt.includes('Dừng') || txt.includes('Stop') || aria.includes('Dừng') || aria.includes('Stop');
                    });

                    // Tìm thẻ video
                    const vids = [];
                    document.querySelectorAll('video').forEach(v => {
                        const src = v.src || v.currentSrc || '';
                        if (src) vids.push(src);
                    });

                    // Tìm các thẻ hình ảnh / phân cảnh được tạo ra
                    const tileImgs = [];
                    document.querySelectorAll('flow-image-tile img, flow-tile-container img, .image').forEach(img => {
                        const s = img.src || '';
                        if (s && s.includes('/asb/')) tileImgs.push(s);
                    });

                    return {isThinking, vids, tileImgs};
                }''')

                # Ưu tiên 1: Lấy từ thẻ video trực tiếp nếu có
                if status.get("vids"):
                    target_src = status["vids"][-1]
                    logger.info(f"[Google Flow] Phát hiện video: {target_src[:80]}...")
                    try:
                        video_b64 = await page.evaluate('''async (url) => {
                            const resp = await fetch(url);
                            const blob = await resp.blob();
                            return new Promise((resolve, reject) => {
                                const reader = new FileReader();
                                reader.onloadend = () => resolve(reader.result.split(',')[1]);
                                reader.onerror = reject;
                                reader.readAsDataURL(blob);
                            });
                        }''', target_src)
                        if video_b64:
                            video_data = base64.b64decode(video_b64)
                            break
                    except Exception as exc:
                        logger.warning(f"[Google Flow] Lỗi trích xuất video src: {exc}")

                # Ưu tiên 2: Khi đã xuất hiện phân cảnh mới trên khung canvas
                new_tiles = [s for s in status.get("tileImgs", []) if s not in existing_imgs]
                if new_tiles and not status.get("isThinking") and (asyncio.get_event_loop().time() - start_t) > 12:
                    target_src = new_tiles[-1]
                    logger.info(f"[Google Flow] Đã phát hiện phân cảnh được dựng: {target_src[:80]}...")
                    try:
                        tile_b64 = await page.evaluate('''async (imgUrl) => {
                            const resp = await fetch(imgUrl);
                            const blob = await resp.blob();
                            return new Promise((resolve, reject) => {
                                const reader = new FileReader();
                                reader.onloadend = () => resolve(reader.result.split(',')[1]);
                                reader.onerror = reject;
                                reader.readAsDataURL(blob);
                            });
                        }''', target_src)
                        if tile_b64:
                            video_data = base64.b64decode(tile_b64)
                            logger.info(f"[Google Flow] Đã trích xuất thành công tài nguyên media ({len(video_data):,} bytes)")
                            break
                    except Exception as exc:
                        logger.warning(f"[Google Flow] Lỗi tải tài nguyên phân cảnh: {exc}")

                await page.wait_for_timeout(3000)

            if not video_data:
                err_shot = VIDEOS_DIR / f"flow_timeout_{uuid.uuid4().hex[:6]}.png"
                await page.screenshot(path=str(err_shot))
                raise RuntimeError(
                    f"Google Flow chưa hoàn tất tạo video sau {max_wait_seconds}s. "
                    f"Cửa sổ Edge vẫn được giữ nguyên trên màn hình để bạn xem trực tiếp."
                )

            # Xác định định dạng tệp thực tế (MP4 hoặc WebP animation/video)
            is_webp = video_data.startswith(b"RIFF") and b"WEBP" in video_data[:16]
            ext = "webp" if is_webp else "mp4"
            filename = f"flow_{uuid.uuid4().hex[:12]}.{ext}"
            output_path = VIDEOS_DIR / filename
            with open(output_path, "wb") as f:
                f.write(video_data)

            local_url = f"http://127.0.0.1:{settings.PORT}/outputs/videos/{filename}"
            logger.info(f"[Google Flow] Đã lưu thành công video vào: {output_path} ({len(video_data):,} bytes)")
            # KHÔNG đóng tab page để người dùng vẫn theo dõi được trực tiếp trên màn hình
            return local_url

    async def generate_video_vids(
        self,
        prompt: str,
        aspect_ratio: str = "16:9",
        duration: int = 10,
        max_wait_seconds: int = 300,
    ) -> str:
        """Tạo video tự động trên Google Vids (vids.new) với cửa sổ trực quan mở trên màn hình."""
        clean_dur = float(duration or 5.0)
        supported_dur = 10 if clean_dur >= 7.5 else 5
        prompt = re.sub(r'\b\d+-second clip\b', f'{supported_dur}-second clip', prompt, flags=re.IGNORECASE)
        prompt = re.sub(r'\bcontinuous motion over \d+ seconds\b', f'continuous motion over {supported_dur} seconds', prompt, flags=re.IGNORECASE)
        async with self._lock:
            context = await self._ensure_browser_context()

            # Tìm tab Google Vids đang mở sẵn hoặc mở tab mới
            page = None
            for p in context.pages:
                if "docs.google.com/videos" in p.url or "vids.google.com" in p.url:
                    page = p
                    break

            if not page:
                page = await context.new_page()
                logger.info("[Google Vids] Đang mở trang https://vids.new...")
                await page.goto("https://vids.new", wait_until="domcontentloaded", timeout=45000)

            await page.bring_to_front()
            await page.wait_for_timeout(2000)

            # 1. Kiểm tra trạng thái đăng nhập
            await self._wait_for_user_login(page, "Google Vids")

            # 2. Đóng hộp thoại preview cũ nếu có để tránh che màn hình
            try:
                await page.evaluate('''() => {
                    const closeBtns = Array.from(document.querySelectorAll('button[aria-label*="Đóng"], button[aria-label*="Close"]'));
                    for (const b of closeBtns) {
                        if (b.offsetWidth > 0 && b.offsetHeight > 0) {
                            b.click();
                            break;
                        }
                    }
                }''')
            except Exception:
                pass

            # 3. Nhấp vào ô 'Tạo video AI' trong thanh công cụ nếu sidebar chưa mở
            try:
                clicked = await page.evaluate('''() => {
                    const elements = Array.from(document.querySelectorAll('*'));
                    const target = elements.find(el => {
                        const t = (el.innerText || '').trim();
                        const tip = el.getAttribute('data-tooltip') || '';
                        return t === 'Tạo video AI' || tip.includes('Tạo video AI') || t.includes('Tạo với Gemini') || t.includes('Help me create');
                    });
                    if (target) {
                        const clickable = target.closest('button, [role="button"], .appsDocsGettingStartedEntryPointSelectionView') || target;
                        clickable.click();
                        return true;
                    }
                    return false;
                }''')
                if clicked:
                    await page.wait_for_timeout(1500)
            except Exception as e:
                logger.warning(f"[Google Vids] Bỏ qua chọn Tạo video AI: {e}")

            # 4. Ghi nhận danh sách video ĐÃ CÓ TRƯỚC khi bấm tạo (để không lấy nhầm video cũ/video test)
            existing_vids = set(await page.evaluate('''() => {
                const s = [];
                document.querySelectorAll('video').forEach(v => {
                    const src = v.src || v.currentSrc || '';
                    if (src && !src.startsWith('data:')) s.push(src);
                });
                return s;
            }'''))
            logger.info(f"[Google Vids] Đang có {len(existing_vids)} video cũ trên trang. Sẽ chỉ nhận video mới được tạo.")

            # 5. Tìm ô nhập prompt mô tả video
            input_el = await page.wait_for_selector(
                'textarea, [contenteditable="true"], .promptTextArea',
                timeout=15000
            )
            if not input_el:
                raise RuntimeError("Không tìm thấy ô nhập prompt trên Google Vids.")

            await input_el.click()
            await page.keyboard.press("Control+A")
            await page.keyboard.press("Backspace")
            await page.keyboard.type(prompt.strip(), delay=10)
            await page.wait_for_timeout(600)

            # 5.1 Tự động điều chỉnh cài đặt Vids: Độ phân giải 1080p, thời lượng (slider 3-10s) và tỷ lệ khung hình
            try:
                target_dur_vids = max(3, min(10, int(round(clean_dur))))
                await page.evaluate('''async ({ targetDuration, targetAspect }) => {
                    const pillBtn = document.querySelector('button[aria-label^="Cài đặt tạo video"]');
                    if (pillBtn) {
                        pillBtn.click();
                        await new Promise(r => setTimeout(r, 400));
                    }

                    // 1. Độ phân giải 1080p
                    const resBtn = Array.from(document.querySelectorAll('button')).find(e => {
                        const p = e.parentElement;
                        return p && p.innerText && p.innerText.includes('Độ phân giải');
                    });
                    if (resBtn && !resBtn.innerText.includes('1080p')) {
                        resBtn.click();
                        await new Promise(r => setTimeout(r, 350));
                        const opt1080 = Array.from(document.querySelectorAll('li[role="menuitemradio"]')).find(el => el.innerText.includes('1080p'));
                        if (opt1080) {
                            opt1080.click();
                            await new Promise(r => setTimeout(r, 350));
                        }
                    }

                    // 2. Tỷ lệ khung hình
                    const isVertical = targetAspect === '9:16';
                    const aspectBtn = Array.from(document.querySelectorAll('button[role="radio"]')).find(b => {
                        const t = (b.innerText || '').trim();
                        return isVertical ? t.includes('Khổ dọc') : t.includes('Khổ ngang');
                    });
                    if (aspectBtn && aspectBtn.getAttribute('aria-checked') !== 'true') {
                        aspectBtn.click();
                        await new Promise(r => setTimeout(r, 250));
                    }

                    // 3. Thời lượng video (thanh trượt 3s - 10s)
                    const slider = document.querySelector('input[type="range"][aria-label="Thời lượng video"]');
                    if (slider) {
                        slider.value = targetDuration;
                        slider.dispatchEvent(new Event('input', { bubbles: true }));
                        slider.dispatchEvent(new Event('change', { bubbles: true }));
                        await new Promise(r => setTimeout(r, 250));
                    }

                    // 4. Đóng menu cài đặt
                    if (pillBtn) {
                        pillBtn.click();
                    }
                }''', {"targetDuration": target_dur_vids, "targetAspect": aspect_ratio})
                logger.info(f"[Google Vids] Đã tự động cấu hình: Độ phân giải 1080p, Thời lượng {target_dur_vids}s, Tỷ lệ {aspect_ratio}")
                await page.wait_for_timeout(500)
            except Exception as e_vids_set:
                logger.warning(f"[Google Vids] Bỏ qua tự động chỉnh cài đặt 1080p/thời lượng: {e_vids_set}")

            # 6. Kích hoạt nút Tạo video (nút ở góc dưới sidebar hoặc Enter)
            gen_clicked = await page.evaluate('''() => {
                const btns = Array.from(document.querySelectorAll('button, div[role="button"]'));
                for (let i = btns.length - 1; i >= 0; i--) {
                    const b = btns[i];
                    const r = b.getBoundingClientRect();
                    if (r.right > window.innerWidth - 150 && r.bottom > window.innerHeight - 150 && r.width > 20 && r.height > 20) {
                        b.click();
                        return true;
                    }
                }
                return false;
            }''')
            if not gen_clicked:
                gen_btn = await page.query_selector('.collapsiblePromptBoxGenerateButton, button[aria-label="Tạo"]')
                if gen_btn:
                    await gen_btn.click(force=True)
                else:
                    await page.keyboard.press("Control+Enter")

            logger.info(f"[Google Vids] Đã gửi lệnh tạo video ({supported_dur}s): '{prompt[:60]}...'. Đang chờ AI hoàn tất...")
            await page.wait_for_timeout(5000)

            # 7. Theo dõi tiến trình tạo video mới (chỉ nhận video KHÔNG nằm trong existing_vids)
            start_t = asyncio.get_event_loop().time()
            video_data = None
            last_progress = ""

            while (asyncio.get_event_loop().time() - start_t) < max_wait_seconds:
                # Tự động phê duyệt tín dụng nếu xuất hiện thông báo
                try:
                    await page.evaluate('''() => {
                        const labels = Array.from(document.querySelectorAll('.option-label:not(.dimmed)'));
                        for (const el of labels) {
                            const text = el.innerText.trim();
                            if (text === 'Luôn phê duyệt' || text === 'Phê duyệt') {
                                (el.closest('button') || el.closest('[role="button"]') || el.parentElement || el).click();
                                break;
                            }
                        }
                    }''')
                except Exception:
                    pass

                status = await page.evaluate('''() => {
                    const bodyText = document.body.innerText || '';
                    const match = bodyText.match(/(\d+)\s*%\s*Đang tạo/i) || bodyText.match(/Đang tạo.*?(\d+)%/i);
                    const progress = match ? match[1] + '%' : '';

                    const vids = [];
                    document.querySelectorAll('video').forEach(v => {
                        const s = v.src || v.currentSrc || '';
                        if (s && !s.startsWith('data:')) {
                            vids.push({src: s, duration: v.duration || 0, isPaused: v.paused});
                        }
                    });
                    return {progress, vids};
                }''')

                curr_prog = status.get("progress")
                if curr_prog and curr_prog != last_progress:
                    logger.info(f"[Google Vids] Tiến trình tạo: {curr_prog}")
                    last_progress = curr_prog

                # Lọc ra các video MỚI chưa từng xuất hiện trước đó
                all_current = [v["src"] for v in status.get("vids", []) if v.get("src")]
                new_vids = [s for s in all_current if s not in existing_vids]

                if new_vids:
                    target_src = new_vids[-1]
                    logger.info(f"[Google Vids] Phát hiện video mới hoàn thành: {target_src[:80]}...")
                    try:
                        resp = await page.request.get(target_src)
                        if resp.status == 200:
                            b_data = await resp.body()
                            if b_data and len(b_data) > 50000:
                                video_data = b_data
                                logger.info(f"[Google Vids] Tải thành công video mới ({len(b_data):,} bytes)")
                                break
                    except Exception as dl_err:
                        logger.warning(f"[Google Vids] Đang chờ video hoàn thiện: {dl_err}")

                await page.wait_for_timeout(4000)

            if not video_data:
                err_shot = VIDEOS_DIR / f"vids_timeout_{uuid.uuid4().hex[:6]}.png"
                await page.screenshot(path=str(err_shot))
                raise RuntimeError(
                    f"Google Vids chưa hoàn tất tạo video sau {max_wait_seconds}s. "
                    f"Cửa sổ Edge vẫn được giữ nguyên trên màn hình để bạn theo dõi tiếp."
                )

            is_webp = video_data.startswith(b"RIFF") and b"WEBP" in video_data[:16]
            ext = "webp" if is_webp else "mp4"
            filename = f"vids_{uuid.uuid4().hex[:12]}.{ext}"
            output_path = VIDEOS_DIR / filename
            with open(output_path, "wb") as f:
                f.write(video_data)

            local_url = f"http://127.0.0.1:{settings.PORT}/outputs/videos/{filename}"
            logger.info(f"[Google Vids] Đã xuất video thành công: {output_path} ({len(video_data):,} bytes)")
            return local_url
    async def generate_video(
        self,
        prompt: str,
        service: str = "vids",
        aspect_ratio: str = "16:9",
        duration: int = 10,
    ) -> str:
        """Bộ điều phối chọn dịch vụ tạo video (Ưu tiên Google Vids -> Fallback sang Google Flow)."""
        target = (service or "vids").lower().strip()
        if "vid" in target:
            try:
                return await self.generate_video_vids(prompt, aspect_ratio=aspect_ratio, duration=duration)
            except Exception as exc:
                fallback_msg = "[Fallback] Vids không khả dụng hoặc lỗi, tự động chuyển phân cảnh sang Google Flow"
                print(fallback_msg, flush=True)
                logger.warning(f"{fallback_msg} (Lỗi: {exc})")
                return await self.generate_video_flow(prompt, aspect_ratio=aspect_ratio, duration=duration)
        return await self.generate_video_flow(prompt, aspect_ratio=aspect_ratio, duration=duration)


video_manager = VideoAutomationManager()
